# Python (backend, Python 3.12)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# Node / frontend (Vue 3 + Vite + TypeScript)
node_modules/
.pnpm-store/
.npm/
.yarn/
.vite/
*.tsbuildinfo

# Build outputs
dist/
build/
out/
# Signed packages and repair leftovers. Keep them on disk; do not version them.
dist-app-repair*/
dist-hardware-candidate/
# Cloud admin SPA. Rebuild with `npm --prefix frontend run build:cloud`.
cloud/admin-dist/
coverage/
.nyc_output/
.cache/
test-results/
playwright-report/

# Local environment and secrets (project must contain no secrets)
.env
.env.*
!.env.example
.dev.vars
**/.dev.vars
cloud/.dev.vars
.local/
.venue-logs/
secrets/
*.pem
*.key
# Wrangler local state
cloud/.wrangler/
**/.wrangler/

# Local config backups (scripts/backup-config.ps1)
backups/

# Local runtime state and user configuration overrides
config/local.yaml
config/*.local.yaml
*.local.yaml
# Device-local active scene — never ship or overwrite with scene releases
config/runtime.yaml
# This desk's generated id and saved execution role. Created on first use.
config/instance.json
config/desk-role.json
# Local Auto/BPM prefs and the BPM epoch marker. Device-local, not a scene file.
config/location-show/
config/bpm-epoch
# Mistaken path if a process used backend/ as config root. Keep on disk; do not commit.
backend/location-show/
# Legacy/mistaken path — cloud metadata must never live under config/
config/cloud-metadata.json
# Operator password hash for the LAN desk. Created by the password CLI.
config/desk-operator.secret

# Home show bench: audio, video, traces. Regenerated locally. Not a source archive.
show-bench/

# Local acceptance screenshots (kept out of the repository on purpose)
.tmp-shots/
.tmp-splash-frames/
docs/captures/
docs/review-screenshots/

# Scratch prefs copies. Not a config root.
backend/_tmp_phase/
backend/_tmp_phase*/

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Canon archives and ad-hoc dumps (canon lives only in the tracked Markdown files)
.context/archive/
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.bak
*.orig
*.tmp

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Uncompressed Auto preview dump; the gzipped pack is the tracked artifact.
cloud/src/scenes/autoPreviewPack.json
