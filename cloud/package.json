{
  "name": "orng-led-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run --maxWorkers=1 --no-isolate",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers --maxWorkers=1 --no-isolate",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:admin": "npm --prefix ../frontend run build:cloud",
    "db:migrate:local": "wrangler d1 migrations apply orng-led-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply orng-led-control --remote"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^4.20250317.0",
    "@types/node": "^22.13.10",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.4.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "$@cloudflare/workers-types"
  }
}
