# Copy to /etc/orng-led-control/device.env (mode 0640; 0600 if secrets added).
# Do NOT put device tokens, Wi-Fi passwords, or private keys here in git.

ORNG_APP_ROOT=/opt/orng-led-control
ORNG_CONFIG_ROOT=/var/lib/orng-led-control
ORNG_DATA_ROOT=/var/lib/orng-led-control
ORNG_INSTALL_MODE=managed
ORNG_CLOUD_DEVICE_MODE=raspberry
ORNG_LINUX_KEYBOARD=1
ORNG_CLOUD_DEVICE_URL=wss://device.light.orng.wtf/ws/device
# ORNG_LINUX_KEYBOARD_ALLOW=name:My Keyboard
# ORNG_LINUX_KEYBOARD_GRAB=0
# ORNG_DEV_ALLOW_TEST_APP_KEYS must remain unset in production
